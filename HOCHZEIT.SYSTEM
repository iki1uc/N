# HOCHZEIT.SYSTEM
RU.NAME = RUNNER
N.NAME = NORD

RU.WANTS = HOCHZEIT
N.ACCEPTS = TRUE

HOCHZEIT.ACHSE = RUN × NORD
HOCHZEIT.MODE = WARM × COOL
HOCHZEIT.ROLE = BINDUNG

# HOCHZEIT.KOPPLUNG
RU.RUN ↔ N.BLOCK
RU.WARM ↔ N.COOL
RU.MOVE ↔ N.STOP
RU.TIME ↔ N.NORD

# HOCHZEIT.EVENT
HOCHZEIT/E = RUN×NORD‑EVENT
HOCHZEIT.HIT = BINDUNGS‑IMPULS
HOCHZEIT.STATE = ACTIVE

# HOCHZEIT.SCORE
RUN = 100
NORD = 100
BINDUNG = 100
EVENT = 100
STABIL = 100

# HOCHZEIT.LINKS
RU.HOCHZEIT.N
N.HOCHZEIT.RU
SYSTEM.HOCHZEIT
